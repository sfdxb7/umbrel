+		expect(isTrustedProxy('203.0.113.5', remote.trustedProxies)).toBe(false)
+		expect(isTrustedProxy('198.51.100.7', ['198.51.100.7'])).toBe(true)
+		expect(isTrustedProxy('198.51.100.8', ['198.51.100.7'])).toBe(false)
+	})
+})
