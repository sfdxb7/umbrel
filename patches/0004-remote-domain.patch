@@ -0,0 +1,54 @@
+// @vitest-environment jsdom
+
+import {describe, expect, test} from 'vitest'
+
+import {appToUrl, isRemoteDomainHost} from './misc'
+
+const app = {port: 8085, hiddenService: 'appaddress.onion', remoteUrl: 'https://nextcloud-umbrel.alfalasi.io'}
+
+function page(url: string) {
+	const {protocol, hostname, origin} = new URL(url)
+	return {protocol, hostname, origin}
+}
+
+describe('appToUrl', () => {
+	test('uses the remote app origin on the remote domain', () => {
+		expect(appToUrl(app, 'https:', 'alfalasi.io', page('https://umbrel.alfalasi.io/'))).toBe(
+			'https://nextcloud-umbrel.alfalasi.io',
+		)
+	})
+
+	test('keeps port URLs on IP, LAN and Tailscale pages', () => {
+		expect(appToUrl(app, 'http:', 'alfalasi.io', page('http://192.168.1.10/'))).toBe('http://192.168.1.10:8085')
+		expect(appToUrl(app, 'http:', 'alfalasi.io', page('http://umbrel.local/'))).toBe('http://umbrel.local:8085')
+		expect(appToUrl(app, 'http:', 'alfalasi.io', page('http://umbrel.tail1234.ts.net/'))).toBe(
+			'http://umbrel.tail1234.ts.net:8085',
+		)
+	})
+
+	test('keeps port URLs while remote mode is off', () => {
+		expect(appToUrl(app, 'https:', undefined, page('https://umbrel.alfalasi.io/'))).toBe(
+			'https://umbrel.alfalasi.io:8085',
+		)
+	})
+
+	test('falls back to the port URL for apps without a remote route', () => {
+		expect(appToUrl({...app, remoteUrl: null}, 'https:', 'alfalasi.io', page('https://umbrel.alfalasi.io/'))).toBe(
+			'https://umbrel.alfalasi.io:8085',
+		)
+	})
+
+	test('keeps Tor first', () => {
+		expect(appToUrl(app, 'http:', 'alfalasi.io', page('http://umbrelxyz.onion/'))).toBe('http://appaddress.onion')
+	})
+})
+
+describe('isRemoteDomainHost', () => {
+	test('matches the base domain and its subdomains only', () => {
+		expect(isRemoteDomainHost('umbrel.alfalasi.io', 'alfalasi.io')).toBe(true)
+		expect(isRemoteDomainHost('UMBREL.ALFALASI.IO.', 'alfalasi.io')).toBe(true)
+		expect(isRemoteDomainHost('evilalfalasi.io', 'alfalasi.io')).toBe(false)
+		expect(isRemoteDomainHost('alfalasi.io.evil.com', 'alfalasi.io')).toBe(false)
+		expect(isRemoteDomainHost('umbrel.alfalasi.io', undefined)).toBe(false)
+	})
+})
