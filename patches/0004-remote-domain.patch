+			fakeUmbreld(remote),
+			fakeRequest('192.168.1.10', {origin: 'host', app: 'nextcloud', path: '/'}, 'http'),
+			'gateway-token',
+		)
+		expect(response.url).toBe('http://192.168.1.10:8080/umbrel_/api/v1/auth/handoff')
