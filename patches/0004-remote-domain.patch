+import {describe, expect, test} from 'vitest'
+
+import {
+	appRemoteHost,
+	buildAppHostMap,
+	isRemoteAuthRequest,
+	matchRemoteHost,
+	normaliseHostHeader,
+	remoteAppAuthUrl,
+	resolveRemoteDomain,
+	validateBaseDomain,
+	validateRemoteDomainSettings,
+} from './remote-domain.js'
+import {remoteDispatch} from './lan-ingress.js'
+
+const remote = resolveRemoteDomain({enabled: true, baseDomain: 'alfalasi.io'})!
+
+describe('remote domain settings', () => {
+	test('is off unless explicitly enabled', () => {
+		expect(resolveRemoteDomain(undefined)).toBeUndefined()
+		expect(resolveRemoteDomain({enabled: false, baseDomain: 'alfalasi.io'})).toBeUndefined()
+	})
+
+	test('uses the approved default host names', () => {
+		expect(remote).toEqual({
+			baseDomain: 'alfalasi.io',
+			dashboardHost: 'umbrel.alfalasi.io',
+			authHost: 'umbrel-auth.alfalasi.io',
+			authOrigin: 'https://umbrel-auth.alfalasi.io',
+			appSubdomainTemplate: '{app}-umbrel',
+			allowUnauthenticatedApps: [],
+		})
+		expect(appRemoteHost(remote, 'nextcloud')).toBe('nextcloud-umbrel.alfalasi.io')
+	})
+
+	test('supports custom names', () => {
+		const custom = resolveRemoteDomain({
+			enabled: true,
+			baseDomain: 'example.com',
+			dashboardSubdomain: 'home',
+			authSubdomain: 'login.home',
+			appSubdomainTemplate: '{app}.apps',
+		})!
+		expect(custom.dashboardHost).toBe('home.example.com')
+		expect(custom.authOrigin).toBe('https://login.home.example.com')
+		expect(appRemoteHost(custom, 'Immich')).toBe('immich.apps.example.com')
+	})
+
+	test.each([
+		['alfalasi.io', undefined],
+		['sub.alfalasi.io', undefined],
+		['https://alfalasi.io', 'scheme'],
+		['alfalasi.io:443', 'port'],
+		['alfalasi.io/path', 'path'],
+		['Alfalasi.io', 'case'],
+		['192.168.1.10', 'ip'],
+		['umbrel.local', 'reserved'],
+		['localhost', 'single label'],
+		['-bad.io', 'label'],
+		['', 'empty'],
+	])('validates base domain %s', (value, problem) => {
+		expect(!!validateBaseDomain(value)).toBe(problem !== undefined)
+	})
+
+	test('rejects bad templates and colliding hosts, and never resolves invalid settings', () => {
+		expect(
+			validateRemoteDomainSettings({enabled: true, baseDomain: 'alfalasi.io', appSubdomainTemplate: 'apps'}),
+		).toBeTruthy()
+		expect(
+			validateRemoteDomainSettings({enabled: true, baseDomain: 'alfalasi.io', appSubdomainTemplate: '{app}{app}'}),
+		).toBeTruthy()
+		expect(
+			validateRemoteDomainSettings({enabled: true, baseDomain: 'alfalasi.io', authSubdomain: 'umbrel'}),
+		).toBeTruthy()
+		expect(resolveRemoteDomain({enabled: true, baseDomain: 'https://alfalasi.io'})).toBeUndefined()
+	})
+
+	test('app hosts never collide with the dashboard or auth host', () => {
+		const custom = resolveRemoteDomain({enabled: true, baseDomain: 'alfalasi.io', appSubdomainTemplate: '{app}'})!
+		expect(appRemoteHost(custom, 'umbrel')).toBeUndefined()
+		expect(appRemoteHost(custom, 'umbrel-auth')).toBeUndefined()
+		expect(appRemoteHost(custom, 'bitcoin')).toBe('bitcoin.alfalasi.io')
+		expect(appRemoteHost(remote, 'bad.id')).toBeUndefined()
+		expect(appRemoteHost(remote, 'a'.repeat(80))).toBeUndefined()
+	})
+
+	test('drops app ids that collide case-insensitively', () => {
+		const hosts = buildAppHostMap(remote, ['Files', 'files', 'immich'])
+		expect([...hosts.entries()]).toEqual([['immich-umbrel.alfalasi.io', 'immich']])
+	})
+})
+
+describe('remote host matching', () => {
+	const appHosts = buildAppHostMap(remote, ['nextcloud'])
+
+	test.each([
+		['umbrel.alfalasi.io', {type: 'dashboard'}],
+		['UMBREL.alfalasi.io.', {type: 'dashboard'}],
+		['umbrel.alfalasi.io:443', {type: 'dashboard'}],
+		['umbrel-auth.alfalasi.io', {type: 'auth'}],
+		['nextcloud-umbrel.alfalasi.io', {type: 'app', appId: 'nextcloud'}],
+		['immich-umbrel.alfalasi.io', {type: 'unknown'}],
+		['alfalasi.io', {type: 'unknown'}],
+		['x.umbrel.alfalasi.io', {type: 'unknown'}],
+		['nextcloud-umbrel.alfalasi.io.evil.com', {type: 'outside'}],
+		['evilalfalasi.io', {type: 'outside'}],
+		['umbrel.local', {type: 'outside'}],
+		['192.168.1.10', {type: 'outside'}],
+		['192.168.1.10:80', {type: 'outside'}],
+		['[fd00::1]:443', {type: 'outside'}],
+		['100.64.0.1', {type: 'outside'}],
+		[undefined, {type: 'outside'}],
+	])('%s', (host, expected) => {
+		expect(matchRemoteHost(remote, appHosts, host)).toEqual(expected)
+	})
+
+	test('treats everything as outside while the mode is off', () => {
+		expect(matchRemoteHost(undefined, appHosts, 'nextcloud-umbrel.alfalasi.io')).toEqual({type: 'outside'})
+	})
+
+	test('normalises Host headers and refuses odd ones', () => {
+		expect(normaliseHostHeader('Umbrel.Alfalasi.IO:443')).toBe('umbrel.alfalasi.io')
+		expect(normaliseHostHeader('umbrel.alfalasi.io:abc')).toBeUndefined()
+		expect(normaliseHostHeader('user@umbrel.alfalasi.io')).toBeUndefined()
+	})
+
+	test('only the exact auth host accepts the remote login flow', () => {
+		expect(isRemoteAuthRequest(remote, 'umbrel-auth.alfalasi.io')).toBe(true)
+		expect(isRemoteAuthRequest(remote, 'umbrel.alfalasi.io')).toBe(false)
+		expect(isRemoteAuthRequest(remote, 'umbrel-auth.alfalasi.io.evil.com')).toBe(false)
+		expect(isRemoteAuthRequest(undefined, 'umbrel-auth.alfalasi.io')).toBe(false)
+	})
+})
+
+describe('remote auth redirect', () => {
+	test('is built from config and encodes the path', () => {
+		const url = new URL(remoteAppAuthUrl(remote, 'nextcloud', '/apps/files?dir=/a&x=1#h'))
+		expect(url.origin).toBe('https://umbrel-auth.alfalasi.io')
+		expect(url.pathname).toBe('/app-auth')
+		expect(Object.fromEntries(url.searchParams)).toEqual({
+			origin: 'remote',
+			app: 'nextcloud',
+			path: '/apps/files?dir=/a&x=1#h',
+		})
+	})
+})
+
+describe('remoteDispatch()', () => {
+	const allowRemote = resolveRemoteDomain({
+		enabled: true,
+		baseDomain: 'alfalasi.io',
+		allowUnauthenticatedApps: ['pihole'],
+	})!
+	const appHosts = buildAppHostMap(allowRemote, ['nextcloud', 'transmission', 'pihole'])
+	const appAuth = (appId: string) => ({nextcloud: true, transmission: false, pihole: false})[appId]
+	const dispatch = (host: string | undefined, protocol: 'http' | 'https' = 'https', remoteDomain = allowRemote) =>
+		remoteDispatch({remote: remoteDomain, appHosts, appAuth, host, protocol})
+
+	test('keeps IP, LAN, mDNS and Tailscale hosts on the dashboard path', () => {
+		for (const host of ['192.168.1.10', 'umbrel.local', '100.64.0.1:443', 'umbrel.tail1234.ts.net', undefined]) {
+			expect(dispatch(host)).toEqual({type: 'dashboard'})
+			expect(dispatch(host, 'http')).toEqual({type: 'dashboard'})
+		}
+	})
+
+	test('serves the dashboard host like any other dashboard request', () => {
+		expect(dispatch('umbrel.alfalasi.io')).toEqual({type: 'dashboard'})
+	})
+
+	test('routes the auth host and apps with Umbrel login', () => {
+		expect(dispatch('umbrel-auth.alfalasi.io')).toEqual({type: 'auth'})
+		expect(dispatch('nextcloud-umbrel.alfalasi.io')).toEqual({type: 'app', appId: 'nextcloud'})
+	})
+
+	test('returns 404 for unknown hosts under the domain instead of the dashboard', () => {
+		expect(dispatch('alfalasi.io')).toMatchObject({type: 'reject', status: 404})
+		expect(dispatch('random-umbrel.alfalasi.io')).toMatchObject({type: 'reject', status: 404})
+		expect(dispatch('random-umbrel.alfalasi.io', 'http')).toMatchObject({type: 'reject', status: 404})
+	})
+
+	test('refuses auth and app hosts on plain HTTP', () => {
+		expect(dispatch('umbrel-auth.alfalasi.io', 'http')).toMatchObject({type: 'reject', status: 421})
+		expect(dispatch('nextcloud-umbrel.alfalasi.io', 'http')).toMatchObject({type: 'reject', status: 421})
+	})
+
+	test('blocks apps with Umbrel login off unless the owner allowed them', () => {
+		expect(dispatch('transmission-umbrel.alfalasi.io')).toMatchObject({type: 'reject', status: 403})
+		expect(dispatch('pihole-umbrel.alfalasi.io')).toEqual({type: 'app', appId: 'pihole'})
+	})
+
+	test('does nothing while the mode is off', () => {
+		expect(
+			remoteDispatch({remote: undefined, appHosts, appAuth, host: 'nextcloud-umbrel.alfalasi.io', protocol: 'https'}),
+		).toEqual({type: 'dashboard'})
+	})
+})
