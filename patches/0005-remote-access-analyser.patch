+type RemoteAccessStatus = {
+	disabled: boolean
+	source: 'heuristic' | 'manifest' | 'local-override' | null
+	hosts: Array<{port: number; origin: string; auth: 'umbrel' | 'app'; routed: boolean}>
+	warnings: string[]
+	declarationErrors: string[]
+}
+
+// Extra browser-facing ports found by the remote access analysis, with the
+// per-app off switch. Details load the saved analysis on demand.
+function RemoteAccessSection({
+	appId,
+	remoteAccess,
+	pending,
+	onToggle,
+}: {
+	appId: string
+	remoteAccess: RemoteAccessStatus
+	pending: boolean
+	onToggle: (enabled: boolean) => void
+}) {
+	const {t} = useTranslation()
+	const [open, setOpen] = React.useState(false)
+	const detailsQ = trpcReact.lanIngress.getRemoteAccess.useQuery({appId}, {enabled: open})
+	const saved = detailsQ.data?.saved
+	const environment = saved?.analysis.env.filter((entry) => entry.kind !== 'internal') ?? []
+	return (
+		<div className='flex w-full flex-col gap-y-2 border-t border-white/6 pt-3'>
+			<div className='flex w-full items-start gap-x-2'>
+				<div className='min-w-0 flex-1 space-y-1'>
+					<h4 className='text-13 leading-tight font-medium'>{t('remote-domain.remote-access')}</h4>
+					<p className='text-12 leading-tight opacity-45'>
+						{remoteAccess.disabled
+							? t('remote-domain.remote-access-disabled')
+							: remoteAccess.hosts.length > 0
+								? t('remote-domain.remote-access-help')
+								: t('remote-domain.remote-access-none')}
+					</p>
+				</div>
+				<Switch checked={!remoteAccess.disabled} disabled={pending} onCheckedChange={onToggle} />
+			</div>
+			{remoteAccess.hosts.map((host) => (
+				<p key={host.port} className='text-12 leading-tight break-all opacity-60'>
+					{t('remote-domain.remote-access-host', {port: host.port, origin: host.origin})}
+					{' · '}
+					{host.auth === 'app' ? t('remote-domain.remote-access-auth-app') : t('remote-domain.remote-access-auth-umbrel')}
+					{!host.routed && !remoteAccess.disabled ? ` · ${t('remote-domain.remote-access-not-routed')}` : ''}
+				</p>
+			))}
+			{[...remoteAccess.declarationErrors, ...remoteAccess.warnings].map((warning) => (
+				<div key={warning} className='flex items-start gap-2'>
+					<TbAlertTriangle className='mt-0.5 size-4 shrink-0 text-[#F5A623]' />
+					<span className='text-12 leading-tight break-words text-white/60'>{warning}</span>
+				</div>
+			))}
+			<details onToggle={(event) => setOpen((event.target as HTMLDetailsElement).open)}>
+				<summary className='cursor-pointer text-12 font-medium opacity-60'>
+					{t('remote-domain.remote-access-details', {
+						source: remoteAccess.source ? t(`remote-domain.remote-access-source-${remoteAccess.source}`) : '',
+					})}
+				</summary>
+				<div className='mt-2 flex flex-col gap-y-1'>
+					{saved ? (
+						<>
+							<p className='text-12 leading-tight opacity-45'>
+								{t('remote-domain.remote-access-analysed', {date: new Date(saved.analysedAt).toLocaleString()})}
+							</p>
+							{environment.map((entry) => (
+								<p key={`${entry.service}.${entry.name}`} className='text-12 leading-tight break-all opacity-60'>
+									<code>
+										{entry.service}.{entry.name}
+									</code>
+									{' · '}
+									{t(`remote-domain.remote-access-kind-${entry.kind}`)}
+									{saved.appliedEnvironment.some(
+										(applied) => applied.service === entry.service && applied.name === entry.name,
+									)
+										? ` · ${t('remote-domain.remote-access-applied')}`
+										: ''}
+								</p>
+							))}
+						</>
+					) : (
+						<p className='text-12 leading-tight opacity-45'>{t('remote-domain.remote-access-not-analysed')}</p>
+					)}
+				</div>
+			</details>
+		</div>
+	)
+}
