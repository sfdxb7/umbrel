index 0000000..8d13cc3
--- /dev/null
+++ b/packages/umbreld/source/modules/app-gateway/remote-ports.ts
@@ -0,0 +1,117 @@
+import crypto from 'node:crypto'
+import type http from 'node:http'
+
+import {rewriteLocalAppUrl, type LocalAppAddress} from '../lan-ingress/remote-domain.js'
+
+// Helpers for an app's extra browser-facing port hosts on the remote domain
+// (https://<app>-<port>-umbrel.<base>), see lan-ingress/remote-access.ts.
+
+export type GatewayPortRoute = {
+	host: string
+	origin: string
+	port: number
+	auth: 'umbrel' | 'app'
+	targetHost: string
+	targetAddress: string
+	containerPort: number
+	lanOrigin: string
+}
+
+// Identifies the set of port hosts that need an Umbrel session. When the
+// marker cookie on the main host differs, the gateway re-runs the handoff
+// chain (new ports, or a session from before ports existed).
+export function remoteHostsMarker(routes: GatewayPortRoute[]) {
+	const hosts = routes
+		.filter((route) => route.auth === 'umbrel')
+		.map((route) => route.host)
+		.sort()
+	if (!hosts.length) return ''
+	return crypto.createHash('sha256').update(hosts.join('\n')).digest('base64url').slice(0, 22)
+}
+
+function escapeHtml(value: string) {
+	return value.replace(/[&<>"']/g, (character) => `&#${character.charCodeAt(0)};`)
+}
+
+// A page that POSTs a single-use handoff to the next host. The handoff never
+// goes in a URL. CSP allows only this script and only this form target.
+export function handoffFormPage(action: string, fields: Record<string, string>) {
+	const nonce = crypto.randomBytes(16).toString('base64')
+	const inputs = Object.entries(fields)
+		.map(([name, value]) => `<input type="hidden" name="${escapeHtml(name)}" value="${escapeHtml(value)}">`)
+		.join('')
+	const body =
+		`<!doctype html><html><head><meta charset="utf-8"><title>Signing in…</title></head><body>` +
+		`<form id="handoff" method="post" action="${escapeHtml(action)}">${inputs}` +
+		`<noscript><button type="submit">Continue</button></noscript></form>` +
+		`<script nonce="${nonce}">document.getElementById('handoff').submit()</script></body></html>`
+	const origin = new URL(action).origin
+	return {
+		body,
+		headers: {
+			'cache-control': 'no-store',
+			'content-type': 'text/html; charset=utf-8',
+			'referrer-policy': 'no-referrer',
+			'content-security-policy': `default-src 'none'; script-src 'nonce-${nonce}'; form-action ${origin}; base-uri 'none'; frame-ancestors 'none'`,
+			'x-content-type-options': 'nosniff',
+		},
+	}
+}
+
+export function isTopLevelNavigation(request: http.IncomingMessage) {
+	if (request.method !== 'GET' && request.method !== 'HEAD') return false
+	const mode = request.headers['sec-fetch-mode']
+	if (typeof mode === 'string') return mode === 'navigate'
+	return String(request.headers.accept ?? '').includes('text/html')
+}
+
+// CORS between an app's own remote hosts (main host and port hosts). Only
+// exact origins of the same app are echoed, with credentials.
+export function corsOrigin(request: http.IncomingMessage, allowedOrigins: string[]) {
+	const origin = request.headers.origin
+	return typeof origin === 'string' && allowedOrigins.includes(origin) ? origin : undefined
+}
+
+export function preflightHeaders(request: http.IncomingMessage, origin: string) {
+	const headers: Record<string, string> = {
+		'access-control-allow-origin': origin,
+		'access-control-allow-credentials': 'true',
+		'access-control-max-age': '600',
+		vary: 'Origin',
+	}
+	const method = request.headers['access-control-request-method']
+	if (typeof method === 'string' && /^[A-Za-z]+$/.test(method)) headers['access-control-allow-methods'] = method
+	const requested = request.headers['access-control-request-headers']
+	if (typeof requested === 'string' && /^[A-Za-z0-9\-_, ]*$/.test(requested) && requested.trim()) {
+		headers['access-control-allow-headers'] = requested
+	}
+	return headers
+}
+
+export function applyCorsHeaders(headers: http.IncomingHttpHeaders, origin: string) {
+	headers['access-control-allow-origin'] = origin
+	headers['access-control-allow-credentials'] = 'true'
+	const vary = typeof headers.vary === 'string' ? headers.vary : ''
+	if (!/\borigin\b/i.test(vary)) headers.vary = vary ? `${vary}, Origin` : 'Origin'
+	// S3-style multipart uploads read ETag from JavaScript.
+	const exposed = typeof headers['access-control-expose-headers'] === 'string' ? headers['access-control-expose-headers'] : ''
+	if (!/\betag\b/i.test(exposed) && exposed.trim() !== '*') {
+		headers['access-control-expose-headers'] = exposed ? `${exposed}, ETag` : 'ETag'
+	}
+}
+
+// A response URL pointing at one of the app's extra ports on the LAN (or at
+// the port's container) becomes that port's remote origin.
+export function rewritePortUrl(value: string, routes: GatewayPortRoute[]) {
+	for (const route of routes) {
+		const local: LocalAppAddress = {
+			lanOrigin: route.lanOrigin,
+			targetHost: route.targetHost,
+			targetAddress: route.targetAddress,
+			targetPort: route.containerPort,
+		}
+		const rewritten = rewriteLocalAppUrl(value, local, route.origin)
+		if (rewritten !== value) return rewritten
+	}
+	return value
+}
