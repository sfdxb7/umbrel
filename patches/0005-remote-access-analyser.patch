@@ -0,0 +1,736 @@
+import net from 'node:net'
+
+import {appPortRemoteHost, appRemoteHost, type RemoteDomain} from './remote-domain.js'
+
+// Remote access analysis: which of an app's ports a browser talks to, and
+// which environment values must change so the app works on the remote domain.
+// Pure: callers pass in the manifest, compose file, static exports and device
+// names. Nothing here is app specific. See docs/remote-domain.md
+// ("Remote access for extra ports") for the heuristic in prose.
+
+export type RemoteAccessAuth = 'umbrel' | 'app'
+
+export type RemoteAccessDeclaration = {
+	// false turns extra ports and env rewrites off for this app.
+	enabled?: boolean
+	// When present, replaces the detected browser-facing ports.
+	ports?: Array<{port: number; auth?: RemoteAccessAuth; service?: string; containerPort?: number}>
+	// Per-variable rewrites, merged over the detected ones. `port: 'main'`
+	// points the value at the app's main remote host; `rewrite: false` keeps it.
+	env?: Array<{service?: string; name: string; port?: number | 'main'; rewrite?: boolean}>
+	// When present, replaces the detected trusted-origin variables.
+	origins?: Array<{service?: string; name: string}>
+}
+
+export type RemoteAccessSource = 'heuristic' | 'manifest' | 'local-override'
+
+export type RemoteAccessPortRole = 'main' | 'browser' | 'lan-only'
+
+export type RemoteAccessPort = {
+	port: number
+	service: string
+	containerPort: number
+	role: RemoteAccessPortRole
+	auth: RemoteAccessAuth
+	// Set when a declaration asked for auth: app but it was not honoured.
+	requestedAuth?: RemoteAccessAuth
+	reasons: string[]
+}
+
+export type RemoteAccessEnvKind =
+	// Points at a browser-facing extra port; rewritten to its remote host.
+	| 'rewrite'
+	// Declared explicitly; rewritten as declared.
+	| 'declared'
+	// Declared rewrite: false.
+	| 'kept'
+	// Device URL on the main port: the gateway already maps it (Host/Location).
+	| 'main-port'
+	// A trusted-origins / allowed-hosts list: public origins are appended.
+	| 'trusted-origins'
+	| 'allowed-hosts'
+	// Device URL to a published port, but the variable name looks server-side.
+	| 'server-side'
+	// Device URL on a port this app does not publish (another app or the dashboard).
+	| 'other-port'
+	// Compose service, container name, localhost or private address.
+	| 'internal'
+	// Host or port uses a variable Umbrel cannot resolve.
+	| 'unresolved'
+
+export type RemoteAccessEnv = {
+	service: string
+	name: string
+	kind: RemoteAccessEnvKind
+	// scheme://host:port only. Userinfo, path and query are never stored.
+	url?: string
+	port?: number
+	reason: string
+}
+
+export type RemoteAccessAnalysis = {
+	version: 1
+	appId: string
+	source: RemoteAccessSource
+	enabled: boolean
+	mainPort: number | null
+	gateway: {service: string | null; host: string; port: number} | null
+	ports: RemoteAccessPort[]
+	env: RemoteAccessEnv[]
+	warnings: string[]
+	declarationErrors: string[]
+}
+
+export type RemoteAccessInput = {
+	appId: string
+	manifest: {port?: unknown; remoteAccess?: unknown} | null
+	compose: unknown
+	// Static `export NAME="value"` assignments from the app's exports.sh.
+	exports?: Record<string, string>
+	// Names and addresses of this device: umbrel.local, <hostname>,
+	// <hostname>.local, LAN IPs. Lowercase.
+	deviceHosts?: string[]
+	localOverride?: unknown
+	// Owner allows this app without Umbrel login (allowUnauthenticatedApps), so a
+	// manifest may ask for auth: app on an extra port.
+	manifestAppAuthAllowed?: boolean
+}
+
+const DEVICE_HOST_VARIABLES = new Set(['DEVICE_DOMAIN_NAME', 'DEVICE_HOSTNAME', 'APP_DOMAIN', 'NETWORK_IP'])
+const DEVICE = '\u0000device'
+const LOOPBACK = new Set(['localhost', '127.0.0.1', '0.0.0.0', '::1', '::', 'host.docker.internal'])
+
+// Variable names whose URLs are used server-side even when they name the
+// device, so they are never handed to a browser.
+const SERVER_SIDE_NAME =
+	/(?:^|_)(?:INTERNAL|PRIVATE|BACKEND|UPSTREAM|SERVER_SIDE|DATABASE|DB|REDIS|MONGO|MONGODB|POSTGRES|POSTGRESQL|PG|MYSQL|MARIADB|AMQP|RABBITMQ|BROKER|SMTP|IMAP|MQTT|KAFKA|ELASTICSEARCH|MEILI|QDRANT)(?:_|$)/
+const TRUSTED_ORIGINS_NAME =
+	/(?:^|_)(?:(?:TRUSTED|ALLOWED|ADDITIONAL_TRUSTED|CSRF_TRUSTED)_ORIGINS?|CORS_(?:ALLOWED_)?ORIGINS?|ALLOW_ORIGINS?|ORIGINS)$/
+const ALLOWED_HOSTS_NAME = /(?:^|_)(?:ALLOWED_HOSTS|TRUSTED_HOSTS)$/
+const S3_NAME = /(?:^|_)(?:S3|MINIO|BUCKET|OBJECT_STORAGE|OBJECT_STORE)(?:_|$)/
+const S3_IMAGE = /(?:^|\/)(?:minio|rustfs|seaweedfs|garage|localstack|s3)[^/]*(?::|$)/i
+
+const TOKEN = String.raw`\$\{[^}]*\}|\$[A-Za-z_][A-Za-z0-9_]*`
+// scheme :// [userinfo@] host [:port]. Host and port may contain ${VAR}.
+const URL_PATTERN = new RegExp(
+	String.raw`(https?|wss?)://((?:[^\s/?#@"'<>,;]*@)?)((?:\[[0-9a-fA-F:.]+\]|${TOKEN}|[A-Za-z0-9._-])+)(?::((?:${TOKEN}|\d)+))?`,
+	'gi',
+)
+
+type Service = {
+	image?: unknown
+	environment?: unknown
+	env_file?: unknown
+	ports?: unknown
+	container_name?: unknown
+	hostname?: unknown
+}
+
+function services(compose: unknown): Array<[string, Service]> {
+	const value = (compose as {services?: unknown} | null)?.services
+	if (!value || typeof value !== 'object') return []
+	return Object.entries(value as Record<string, Service>).filter(([, service]) => service && typeof service === 'object')
+}
+
+export function serviceEnvironment(service: Service) {
+	const environment = new Map<string, string>()
+	if (Array.isArray(service.environment)) {
+		for (const entry of service.environment) {
+			if (typeof entry !== 'string') continue
+			const separator = entry.indexOf('=')
+			if (separator > 0) environment.set(entry.slice(0, separator), entry.slice(separator + 1))
+		}
+	} else if (service.environment && typeof service.environment === 'object') {
+		for (const [name, value] of Object.entries(service.environment)) {
+			if (typeof value === 'string' || typeof value === 'number' || typeof value === 'boolean') {
+				environment.set(name, String(value))
+			}
+		}
+	}
+	return environment
+}
+
+// Parse literal assignments from an exports.sh. Command substitutions and
+// anything else dynamic are ignored. Values may reference earlier exports.
+export function parseStaticExports(contents: string) {
+	const exports: Record<string, string> = {}
+	for (const line of contents.split('\n')) {
+		const match = /^\s*export\s+([A-Za-z_][A-Za-z0-9_]*)=(?:"([^"`]*)"|'([^']*)'|([^\s"'`;|&]*))\s*(?:#.*)?$/.exec(line)
+		if (!match) continue
+		const value = match[2] ?? match[3] ?? match[4] ?? ''
+		if (match[2] !== undefined && value.includes('$(')) continue
+		exports[match[1]!] = value
+	}
+	return exports
+}
+
+type Variables = Record<string, string>
+
+function variableValue(name: string, fallback: string | undefined, variables: Variables, depth: number): string | undefined {
+	if (DEVICE_HOST_VARIABLES.has(name)) return DEVICE
+	const value = variables[name]
+	if (value !== undefined) return depth > 5 ? undefined : resolveVariables(value, variables, depth + 1)
+	return fallback === undefined ? undefined : resolveVariables(fallback, variables, depth + 1)
+}
+
+// Replace ${VAR}, ${VAR:-default} and $VAR. Unknown variables make the result undefined.
+function resolveVariables(value: string, variables: Variables, depth = 0): string | undefined {
+	let unresolved = false
+	const result = value.replace(/\$\{([A-Za-z_][A-Za-z0-9_]*)(?::?-([^}]*))?\}|\$([A-Za-z_][A-Za-z0-9_]*)/g, (_m, a, fallback, b) => {
+		const resolved = variableValue(a ?? b, fallback, variables, depth)
+		if (resolved === undefined) unresolved = true
+		return resolved ?? ''
+	})
+	return unresolved ? undefined : result
+}
+
+export type PublishedPort = {port: number; service: string; containerPort: number}
+
+// Host ports published by the app's own services (app_proxy excluded). UDP,
+// loopback-bound, bare container ports and ranges are not browser reachable.
+export function publishedPorts(compose: unknown, variables: Variables = {}): PublishedPort[] {
+	const result: PublishedPort[] = []
+	for (const [name, service] of services(compose)) {
+		if (name === 'app_proxy' || !Array.isArray(service.ports)) continue
+		for (const entry of service.ports) {
+			let published: unknown
+			let target: unknown
+			let hostIp: string | undefined
+			if (typeof entry === 'object' && entry !== null) {
+				const port = entry as {published?: unknown; target?: unknown; protocol?: unknown; host_ip?: unknown}
+				if (String(port.protocol ?? 'tcp').toLowerCase() !== 'tcp') continue
+				published = port.published
+				target = port.target
+				hostIp = typeof port.host_ip === 'string' ? port.host_ip : undefined
+			} else if (typeof entry === 'string' || typeof entry === 'number') {
+				const raw = resolveVariables(String(entry).trim(), variables)
+				if (!raw || /\/udp$/i.test(raw) || /\/sctp$/i.test(raw)) continue
+				const withoutProtocol = raw.replace(/\/tcp$/i, '')
+				const bracketed = /^\[([^\]]+)\]:(.+)$/.exec(withoutProtocol)
+				const parts = bracketed ? [bracketed[1]!, ...bracketed[2]!.split(':')] : withoutProtocol.split(':')
+				if (parts.length < 2) continue
+				target = parts.at(-1)
+				published = parts.at(-2)
+				hostIp = parts.length > 2 ? parts.slice(0, -2).join(':') : undefined
+			} else {
+				continue
+			}
+			const port = Number(typeof published === 'string' ? resolveVariables(published, variables) : published)
+			const containerPort = Number(typeof target === 'string' ? resolveVariables(target, variables) : target)
+			if (!isPort(port) || !isPort(containerPort)) continue
+			if (hostIp && LOOPBACK.has(hostIp.toLowerCase())) continue
+			if (!result.some((existing) => existing.port === port)) result.push({port, service: name, containerPort})
+		}
+	}
+	return result.sort((a, b) => a.port - b.port)
+}
+
+function isPort(value: number) {
+	return Number.isInteger(value) && value > 0 && value <= 65_535
+}
+
+type HostKind = 'device' | 'internal' | 'external' | 'unresolved'
+
+function internalNames(appId: string, compose: unknown) {
+	const names = new Set<string>()
+	for (const [name, service] of services(compose)) {
+		names.add(name.toLowerCase())
+		names.add(`${appId}_${name}_1`.toLowerCase())
+		if (typeof service.container_name === 'string') names.add(service.container_name.toLowerCase())
+		if (typeof service.hostname === 'string') names.add(service.hostname.toLowerCase())
+	}
+	return names
+}
+
+function isPrivateIp(host: string) {
+	if (net.isIPv4(host)) {
+		const [a, b] = host.split('.').map(Number) as [number, number]
+		return a === 10 || a === 127 || (a === 172 && b >= 16 && b <= 31) || (a === 192 && b === 168) || (a === 169 && b === 254)
+	}
+	if (net.isIPv6(host)) return host === '::1' || /^f[cd]/i.test(host) || /^fe[89ab]/i.test(host)
+	return false
+}
+
+type ParsedUrl = {
+	index: number
+	length: number
+	scheme: string
+	userinfo: string
+	host: string | undefined
+	hostKind: HostKind
+	port: number | undefined
+	explicitPort: boolean
+}
+
+type Context = {appId: string; variables: Variables; deviceHosts: Set<string>; internal: Set<string>}
+
+function classifyHost(host: string | undefined, context: Context): HostKind {
+	if (host === undefined) return 'unresolved'
+	const name = host.replace(/^\[|\]$/g, '').toLowerCase()
+	if (name === DEVICE || name === `${DEVICE}.local`) return 'device'
+	if (name.includes(DEVICE)) return 'unresolved'
+	if (context.deviceHosts.has(name)) return 'device'
+	if (LOOPBACK.has(name) || context.internal.has(name) || /_\d+$/.test(name)) return 'internal'
+	if (net.isIP(name)) return isPrivateIp(name) ? 'internal' : 'external'
+	if (!name.includes('.')) return 'internal'
+	return 'external'
+}
+
+function findUrls(value: string, context: Context): ParsedUrl[] {
+	const urls: ParsedUrl[] = []
+	for (const match of value.matchAll(URL_PATTERN)) {
+		const [whole, scheme, userinfo, rawHost, rawPort] = match
+		const host = resolveVariables(rawHost!, context.variables)
+		const hostKind = classifyHost(host, context)
+		let port: number | undefined
+		if (rawPort !== undefined) {
+			const resolved = resolveVariables(rawPort, context.variables)
+			port = resolved !== undefined && /^\d+$/.test(resolved) ? Number(resolved) : undefined
+		} else {
+			port = /^(?:https|wss)$/i.test(scheme!) ? 443 : 80
+		}
+		urls.push({
+			index: match.index!,
+			length: whole.length,
+			scheme: scheme!.toLowerCase(),
+			userinfo: userinfo ?? '',
+			host,
+			hostKind: rawPort !== undefined && port === undefined && hostKind === 'device' ? 'unresolved' : hostKind,
+			port,
+			explicitPort: rawPort !== undefined,
+		})
+	}
+	return urls
+}
+
+function displayUrl(url: ParsedUrl) {
+	const host = url.hostKind === 'device' ? '<device>' : url.host?.includes(DEVICE) ? '<device>' : (url.host ?? '<unresolved>')
+	return `${url.scheme}://${host}${url.port === undefined ? ':<unresolved>' : `:${url.port}`}`
+}
+
+type ParsedDeclaration = {declaration?: RemoteAccessDeclaration; errors: string[]}
+
+// Validate a remoteAccess block. Invalid entries are dropped and reported.
+export function parseRemoteAccessDeclaration(value: unknown, label: string): ParsedDeclaration {
+	if (value === undefined || value === null) return {errors: []}
+	if (typeof value !== 'object' || Array.isArray(value)) return {errors: [`${label}: remoteAccess must be a mapping`]}
+	const input = value as Record<string, unknown>
+	const errors: string[] = []
+	const declaration: RemoteAccessDeclaration = {}
+	const name = (entry: unknown) => typeof entry === 'string' && /^[A-Za-z_][A-Za-z0-9_]*$/.test(entry)
+	const service = (entry: unknown) => entry === undefined || (typeof entry === 'string' && /^[A-Za-z0-9._-]+$/.test(entry))
+	for (const key of Object.keys(input)) {
+		if (!['enabled', 'ports', 'env', 'origins'].includes(key)) errors.push(`${label}: unknown key '${key}'`)
+	}
+	if (input.enabled !== undefined) {
+		if (typeof input.enabled === 'boolean') declaration.enabled = input.enabled
+		else errors.push(`${label}: enabled must be true or false`)
+	}
+	if (input.ports !== undefined) {
+		declaration.ports = []
+		for (const [index, entry] of (Array.isArray(input.ports) ? input.ports : []).entries()) {
+			const port = typeof entry === 'number' ? {port: entry} : (entry as Record<string, unknown>)
+			const auth = port?.auth ?? 'umbrel'
+			if (
+				!port ||
+				!isPort(Number(port.port)) ||
+				(auth !== 'umbrel' && auth !== 'app') ||
+				!service(port.service) ||
+				(port.containerPort !== undefined && !isPort(Number(port.containerPort)))
+			) {
+				errors.push(`${label}: ports[${index}] is invalid`)
+				continue
+			}
+			declaration.ports.push({
+				port: Number(port.port),
+				auth,
+				...(port.service ? {service: port.service as string} : {}),
+				...(port.containerPort ? {containerPort: Number(port.containerPort)} : {}),
+			})
+		}
+		if (!Array.isArray(input.ports)) errors.push(`${label}: ports must be a list`)
+	}
+	if (input.env !== undefined) {
+		declaration.env = []
+		for (const [index, entry] of (Array.isArray(input.env) ? input.env : []).entries()) {
+			const env = entry as Record<string, unknown>
+			const port = env?.port
+			if (
+				!env ||
+				!name(env.name) ||
+				!service(env.service) ||
+				(port !== undefined && port !== 'main' && !isPort(Number(port))) ||
+				(env.rewrite !== undefined && typeof env.rewrite !== 'boolean') ||
+				(port === undefined && env.rewrite !== false)
+			) {
+				errors.push(`${label}: env[${index}] is invalid`)
+				continue
+			}
+			declaration.env.push({
+				name: env.name as string,
+				...(env.service ? {service: env.service as string} : {}),
+				...(port !== undefined ? {port: port === 'main' ? 'main' : Number(port)} : {}),
+				...(env.rewrite === false ? {rewrite: false} : {}),
+			})
+		}
+		if (!Array.isArray(input.env)) errors.push(`${label}: env must be a list`)
+	}
+	if (input.origins !== undefined) {
+		declaration.origins = []
+		for (const [index, entry] of (Array.isArray(input.origins) ? input.origins : []).entries()) {
+			const origin = typeof entry === 'string' ? {name: entry} : (entry as Record<string, unknown>)
+			if (!origin || !name(origin.name) || !service(origin.service)) {
+				errors.push(`${label}: origins[${index}] is invalid`)
+				continue
+			}
+			declaration.origins.push({name: origin.name as string, ...(origin.service ? {service: origin.service as string} : {})})
+		}
+		if (!Array.isArray(input.origins)) errors.push(`${label}: origins must be a list`)
+	}
+	return {declaration, errors}
+}
+
+function matchesEntry(entry: {service?: string; name: string}, service: string, name: string) {
+	return entry.name === name && (entry.service === undefined || entry.service === service)
+}
+
+function isS3Port(port: PublishedPort, compose: unknown, envNames: string[]) {
+	const service = services(compose).find(([name]) => name === port.service)?.[1]
+	return (typeof service?.image === 'string' && S3_IMAGE.test(service.image)) || envNames.some((name) => S3_NAME.test(name))
+}
+
+export function analyseRemoteAccess(input: RemoteAccessInput): RemoteAccessAnalysis {
+	const {appId, compose} = input
+	const manifestPort = Number(input.manifest?.port)
+	const mainPort = isPort(manifestPort) ? manifestPort : null
+	const variables: Variables = {
+		...(input.exports ?? {}),
+		APP_ID: appId,
+		...(mainPort ? {APP_PROXY_PORT: String(mainPort)} : {}),
+	}
+	const context: Context = {
+		appId,
+		variables,
+		deviceHosts: new Set(['umbrel.local', ...(input.deviceHosts ?? [])].map((host) => host.toLowerCase())),
+		internal: internalNames(appId, compose),
+	}
+	const warnings: string[] = []
+
+	// Precedence: local override, then manifest, then the heuristic.
+	const local = parseRemoteAccessDeclaration(input.localOverride, 'local override')
+	const manifest = parseRemoteAccessDeclaration(input.manifest?.remoteAccess, 'manifest')
+	const declarationErrors = [...local.errors, ...manifest.errors]
+	const source: RemoteAccessSource = local.declaration
+		? 'local-override'
+		: manifest.declaration
+			? 'manifest'
+			: 'heuristic'
+	const declaration = local.declaration ?? manifest.declaration
+	const enabled = declaration?.enabled !== false
+
+	const allServices = services(compose)
+	const appProxy = allServices.find(([name]) => name === 'app_proxy')?.[1]
+	let gateway: RemoteAccessAnalysis['gateway'] = null
+	if (appProxy) {
+		const environment = serviceEnvironment(appProxy)
+		const host = resolveVariables(environment.get('APP_HOST') ?? '', variables)?.trim()
+		const port = Number(resolveVariables(environment.get('APP_PORT') ?? '', variables))
+		if (host && isPort(port)) {
+			const lower = host.toLowerCase()
+			const service =
+				allServices.find(
+					([name, service]) =>
+						name !== 'app_proxy' &&
+						(name.toLowerCase() === lower ||
+							`${appId}_${name}_1`.toLowerCase() === lower ||
+							(typeof service.container_name === 'string' && service.container_name.toLowerCase() === lower) ||
+							(typeof service.hostname === 'string' && service.hostname.toLowerCase() === lower)),
+				)?.[0] ?? null
+			gateway = {service, host, port}
+		}
+	}
+
+	const published = publishedPorts(compose, variables)
+	const publishedByPort = new Map(published.map((port) => [port.port, port]))
+	const declaredEnv = declaration?.env ?? []
+	const declaredOrigins = declaration?.origins
+
+	const env: RemoteAccessEnv[] = []
+	const browserPorts = new Map<number, {reasons: string[]; envNames: string[]}>()
+	const addBrowserPort = (port: number, reason: string, envName?: string) => {
+		const entry = browserPorts.get(port) ?? {reasons: [], envNames: []}
+		if (!entry.reasons.includes(reason)) entry.reasons.push(reason)
+		if (envName) entry.envNames.push(envName)
+		browserPorts.set(port, entry)
+	}
+
+	for (const [serviceName, service] of allServices) {
+		if (serviceName === 'app_proxy') continue
+		if (service.env_file !== undefined) {
+			warnings.push(
+				`Service '${serviceName}' loads an env_file, which is not scanned. Declare any browser-facing URL in it under remoteAccess.env.`,
+			)
+		}
+		for (const [name, value] of serviceEnvironment(service)) {
+			const declared = declaredEnv.find((entry) => matchesEntry(entry, serviceName, name))
+			const trusted = declaredOrigins
+				? declaredOrigins.some((entry) => matchesEntry(entry, serviceName, name))
+				: TRUSTED_ORIGINS_NAME.test(name)
+			if (trusted) {
+				const wildcard = value.split(/[\s,]+/).includes('*')
+				env.push({
+					service: serviceName,
+					name,
+					kind: 'trusted-origins',
+					reason: wildcard ? 'Allows any origin (*); left unchanged' : 'Trusted-origin list; remote origins are appended',
+				})
+				continue
+			}
+			if (!declaredOrigins && ALLOWED_HOSTS_NAME.test(name)) {
+				const wildcard = value.split(/[\s,]+/).includes('*')
+				env.push({
+					service: serviceName,
+					name,
+					kind: 'allowed-hosts',
+					reason: wildcard ? 'Allows any host (*); left unchanged' : 'Allowed-hosts list; remote hosts are appended',
+				})
+				continue
+			}
+			const urls = findUrls(value, context)
+			if (declared) {
+				if (declared.rewrite === false) {
+					env.push({service: serviceName, name, kind: 'kept', reason: `Declared rewrite: false (${source})`})
+					continue
+				}
+				const target = declared.port === 'main' ? 'main' : declared.port!
+				const first = urls.find((url) => url.hostKind === 'device' || url.hostKind === 'unresolved')
+				env.push({
+					service: serviceName,
+					name,
+					kind: 'declared',
+					...(first ? {url: displayUrl(first)} : {}),
+					...(target === 'main' ? (mainPort ? {port: mainPort} : {}) : {port: target}),
+					reason: `Declared in ${source}: points at ${target === 'main' ? 'the main host' : `port ${target}`}`,
+				})
+				if (!first) warnings.push(`Declared variable ${serviceName}.${name} has no device URL to rewrite.`)
+				continue
+			}
+			for (const url of urls) {
+				const entry = {service: serviceName, name, url: displayUrl(url), ...(url.port ? {port: url.port} : {})}
+				if (url.hostKind === 'external') continue
+				if (url.hostKind === 'internal') {
+					env.push({...entry, kind: 'internal', reason: 'Container, service or loopback address; never rewritten'})
+					continue
+				}
+				if (url.hostKind === 'unresolved' || url.port === undefined) {
+					env.push({...entry, kind: 'unresolved', reason: 'Host or port uses a variable Umbrel cannot resolve'})
+					warnings.push(
+						`${serviceName}.${name} uses a URL Umbrel cannot resolve. If a browser uses it, declare it under remoteAccess.env.`,
+					)
+					continue
+				}
+				if (url.port === mainPort) {
+					env.push({
+						...entry,
+						kind: 'main-port',
+						reason: 'Main port: the gateway already maps Host, Origin and redirects, so it is not rewritten',
+					})
+					continue
+				}
+				const port = publishedByPort.get(url.port)
+				if (!port) {
+					env.push({...entry, kind: 'other-port', reason: 'Not a port this app publishes; left unchanged'})
+					continue
+				}
+				if (SERVER_SIDE_NAME.test(name)) {
+					env.push({...entry, kind: 'server-side', reason: 'Variable name looks server-side; not rewritten'})
+					warnings.push(
+						`${serviceName}.${name} points at published port ${url.port} but its name looks server-side, so it is not rewritten. Declare it if a browser uses it.`,
+					)
+					continue
+				}
+				env.push({...entry, kind: 'rewrite', reason: `Browser-facing URL to published port ${url.port}`})
+				if (!declaration?.ports) addBrowserPort(url.port, `${serviceName}.${name} hands a browser ${displayUrl(url)}`, name)
+			}
+		}
+	}
+	for (const entry of declaredEnv) {
+		if (!env.some((item) => matchesEntry(entry, item.service, item.name) && (item.kind === 'declared' || item.kind === 'kept'))) {
+			warnings.push(`Declared variable ${entry.service ? `${entry.service}.` : ''}${entry.name} is not set in the compose file.`)
+		}
+	}
+
+	const ports: RemoteAccessPort[] = []
+	const manifestAppAuthAllowed = !!input.manifestAppAuthAllowed
+	if (declaration?.ports) {
+		for (const declared of declaration.ports) {
+			const publishedPort = publishedByPort.get(declared.port)
+			const service = declared.service ?? publishedPort?.service
+			const containerPort = declared.containerPort ?? publishedPort?.containerPort
+			if (!service || !containerPort || !allServices.some(([name]) => name === service)) {
+				declarationErrors.push(`${source}: port ${declared.port} is not published; give service and containerPort`)
+				continue
+			}
+			if (declared.port === mainPort) {
+				declarationErrors.push(`${source}: port ${declared.port} is the main port`)
+				continue
+			}
+			const wantsAppAuth = declared.auth === 'app'
+			const honoured = wantsAppAuth && (source === 'local-override' || manifestAppAuthAllowed)
+			ports.push({
+				port: declared.port,
+				service,
+				containerPort,
+				role: 'browser',
+				auth: honoured ? 'app' : 'umbrel',
+				...(wantsAppAuth && !honoured ? {requestedAuth: 'app' as const} : {}),
+				reasons: [
+					`Declared in ${source}`,
+					...(wantsAppAuth && !honoured
+						? ["The manifest asks for auth: app; kept behind Umbrel login until the owner allows this app without Umbrel's login"]
+						: []),
+				],
+			})
+		}
+	} else {
+		for (const [port, detail] of browserPorts) {
+			const publishedPort = publishedByPort.get(port)!
+			ports.push({...publishedPort, role: 'browser', auth: 'umbrel', reasons: detail.reasons})
+		}
+	}
+	// Declared env entries pointing at a port that is not routed are an error.
+	for (const entry of env) {
+		if (entry.kind !== 'declared' || entry.port === undefined || entry.port === mainPort) continue
+		if (!ports.some((port) => port.port === entry.port)) {
+			declarationErrors.push(`${source}: ${entry.service}.${entry.name} points at port ${entry.port}, which is not a declared port`)
+		}
+	}
+	for (const port of published) {
+		if (ports.some((existing) => existing.port === port.port)) continue
+		ports.push({
+			...port,
+			role: port.port === mainPort ? 'main' : 'lan-only',
+			auth: 'umbrel',
+			reasons: [
+				port.port === mainPort ? 'Main port published directly' : 'Published, but no browser-facing URL points at it; LAN only',
+			],
+		})
+	}
+	ports.sort((a, b) => a.port - b.port)
+
+	for (const port of ports) {
+		if (port.role !== 'browser' || port.auth !== 'umbrel') continue
+		const envNames = browserPorts.get(port.port)?.envNames ?? []
+		if (isS3Port(port, compose, envNames)) {
+			warnings.push(
+				`Port ${port.port} looks like S3 object storage. Browsers usually send presigned uploads with fetch() and no credentials, so they carry no Umbrel cookie and get 401 on the remote host; <img> loads and downloads work. If remote uploads fail, declare this port with auth: app in the local override (the storage server then relies on its own signatures).`,
+			)
+		}
+	}
+
+	return {
+		version: 1,
+		appId,
+		source,
+		enabled,
+		mainPort,
+		gateway,
+		ports: enabled ? ports : ports.map((port) => ({...port, role: port.role === 'main' ? 'main' : 'lan-only'})),
+		env,
+		warnings,
+		declarationErrors,
+	}
+}
+
+// The extra hosts an analysis asks for: browser-facing ports only.
+export function remoteAccessPorts(analysis: RemoteAccessAnalysis) {
+	if (!analysis.enabled) return []
+	return analysis.ports.filter((port) => port.role === 'browser')
+}
+
+export function remoteAccessOrigins(remote: RemoteDomain, appId: string, analysis: RemoteAccessAnalysis) {
+	const main = appRemoteHost(remote, appId)
+	const hosts = [
+		...(main ? [main] : []),
+		...remoteAccessPorts(analysis).flatMap((port) => appPortRemoteHost(remote, appId, port.port) ?? []),
+	]
+	return hosts
+}
+
+function appendToList(value: string, additions: string[]) {
+	const separator = value.includes(',') || !/\s/.test(value.trim()) ? ',' : ' '
+	const existing = value.split(/[\s,]+/).filter(Boolean)
+	const missing = additions.filter((addition) => !existing.includes(addition))
+	if (!missing.length) return value
+	return value.trim() ? `${value.trim()}${separator}${missing.join(separator)}` : missing.join(separator)
+}
+
+// Environment overrides for the user-settings compose file, keyed by service.
+// Values keep every ${VAR} they had except the rewritten host and port.
+export function remoteAccessEnvironment({
+	remote,
+	appId,
+	analysis,
+	compose,
+	exports = {},
+	deviceHosts = [],
+}: {
+	remote: RemoteDomain
+	appId: string
+	analysis: RemoteAccessAnalysis
+	compose: unknown
+	exports?: Record<string, string>
+	deviceHosts?: string[]
+}) {
+	const overrides: Record<string, Record<string, string>> = {}
+	if (!analysis.enabled) return overrides
+	const routed = new Map(
+		remoteAccessPorts(analysis).flatMap((port) => {
+			const host = appPortRemoteHost(remote, appId, port.port)
+			return host ? [[port.port, host] as const] : []
+		}),
+	)
+	const mainHost = appRemoteHost(remote, appId)
+	const hosts = remoteAccessOrigins(remote, appId, analysis)
+	const origins = hosts.map((host) => `https://${host}`)
+	const mainPort = analysis.mainPort
+	const context: Context = {
+		appId,
+		variables: {...exports, APP_ID: appId, ...(mainPort ? {APP_PROXY_PORT: String(mainPort)} : {})},
+		deviceHosts: new Set(['umbrel.local', ...deviceHosts].map((host) => host.toLowerCase())),
+		internal: internalNames(appId, compose),
+	}
+	const byService = new Map(services(compose))
+	const set = (service: string, name: string, value: string) => {
+		;(overrides[service] ??= {})[name] = value
+	}
+	for (const entry of analysis.env) {
+		const raw = byService.get(entry.service) && serviceEnvironment(byService.get(entry.service)!).get(entry.name)
+		if (raw === undefined) continue
+		if (entry.kind === 'trusted-origins' || entry.kind === 'allowed-hosts') {
+			if (raw.split(/[\s,]+/).includes('*')) continue
+			const next = appendToList(raw, entry.kind === 'trusted-origins' ? origins : hosts)
+			if (next !== raw) set(entry.service, entry.name, next)
+			continue
+		}
+		if (entry.kind !== 'rewrite' && entry.kind !== 'declared') continue
+		const targetHost =
+			entry.kind === 'declared' && entry.port === mainPort ? mainHost : entry.port ? routed.get(entry.port) : undefined
+		if (!targetHost) continue
+		let next = ''
+		let last = 0
+		for (const url of findUrls(raw, context)) {
+			const matches =
+				entry.kind === 'declared'
+					? url.hostKind === 'device' || url.hostKind === 'unresolved'
+					: url.hostKind === 'device' && url.port === entry.port
+			if (!matches) continue
+			const scheme = url.scheme === 'ws' || url.scheme === 'wss' ? 'wss' : 'https'
+			next += `${raw.slice(last, url.index)}${scheme}://${url.userinfo}${targetHost}`
+			last = url.index + url.length
+		}
+		next += raw.slice(last)
+		if (next !== raw) set(entry.service, entry.name, next)
+	}
+	return overrides
+}
