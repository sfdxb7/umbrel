+import fs from 'node:fs'
+import path from 'node:path'
+import {fileURLToPath} from 'node:url'
+
+import {describe, expect, test} from 'vitest'
+import yaml from 'js-yaml'
+
+import {
+	analyseRemoteAccess,
+	parseRemoteAccessDeclaration,
+	parseStaticExports,
+	publishedPorts,
+	remoteAccessEnvironment,
+	remoteAccessOrigins,
+	remoteAccessPorts,
+	type RemoteAccessAnalysis,
+} from './remote-access.js'
+import {resolveRemoteDomain} from './remote-domain.js'
+
+// Fixtures are getumbrel/umbrel-apps templates with fake values for secrets.
+const fixtures = path.join(path.dirname(fileURLToPath(import.meta.url)), 'fixtures', 'remote-access')
+const remote = resolveRemoteDomain({enabled: true, baseDomain: 'example.com'})!
+const deviceHosts = ['umbrel.local', 'umbrel', '192.168.1.20']
+
+function fixture(appId: string) {
+	const read = (file: string) => {
+		const full = path.join(fixtures, appId, file)
+		return fs.existsSync(full) ? fs.readFileSync(full, 'utf8') : undefined
+	}
+	return {
+		manifest: yaml.load(read('umbrel-app.yml')!) as {port?: unknown; remoteAccess?: unknown},
+		compose: yaml.load(read('docker-compose.yml')!),
+		exports: parseStaticExports(read('exports.sh') ?? ''),
+	}
+}
+
+function analyse(appId: string, extra: Partial<Parameters<typeof analyseRemoteAccess>[0]> = {}) {
+	const {manifest, compose, exports} = fixture(appId)
+	const analysis = analyseRemoteAccess({appId, manifest, compose, exports, deviceHosts, ...extra})
+	const environment = remoteAccessEnvironment({remote, appId, analysis, compose, exports, deviceHosts})
+	return {analysis, environment, compose}
+}
+
+const kinds = (analysis: RemoteAccessAnalysis) =>
+	Object.fromEntries(analysis.env.map((entry) => [`${entry.service}.${entry.name}`, entry.kind]))
+
+describe('analyseRemoteAccess on app-store templates', () => {
+	test('lobe-chat: S3 and agent gateway ports are browser-facing, device gateway stays LAN only', () => {
+		const {analysis, environment} = analyse('lobe-chat')
+		expect(analysis.source).toBe('heuristic')
+		expect(analysis.mainPort).toBe(7455)
+		expect(analysis.gateway).toEqual({service: 'app', host: 'lobe-chat_app_1', port: 3210})
+		expect(remoteAccessPorts(analysis).map((port) => [port.port, port.service, port.containerPort, port.auth])).toEqual([
+			[7458, 'rustfs', 9000, 'umbrel'],
+			[7459, 'gateway', 8787, 'umbrel'],
+		])
+		expect(analysis.ports.find((port) => port.port === 7460)?.role).toBe('lan-only')
+		expect(kinds(analysis)).toMatchObject({
+			'app.APP_URL': 'main-port',
+			'app.AUTH_TRUSTED_ORIGINS': 'trusted-origins',
+			'app.S3_ENDPOINT': 'rewrite',
+			'app.AGENT_GATEWAY_URL': 'rewrite',
+			'app.INTERNAL_APP_URL': 'internal',
+			'app.S3_INTERNAL_ENDPOINT': 'internal',
+			'gateway.LOBE_API_BASE_URL': 'internal',
+		})
+		expect(analysis.warnings.some((warning) => warning.includes('Port 7458 looks like S3'))).toBe(true)
+		expect(analysis.warnings.some((warning) => warning.includes('env_file'))).toBe(true)
+		expect(environment).toEqual({
+			app: {
+				S3_ENDPOINT: 'https://lobe-chat-7458-umbrel.example.com',
+				AGENT_GATEWAY_URL: 'https://lobe-chat-7459-umbrel.example.com',
+				AUTH_TRUSTED_ORIGINS:
+					'http://${DEVICE_DOMAIN_NAME}:7455,https://lobe-chat-umbrel.example.com,https://lobe-chat-7458-umbrel.example.com,https://lobe-chat-7459-umbrel.example.com',
+			},
+		})
+		// Never stores credentials from URLs.
+		expect(JSON.stringify(analysis)).not.toContain('fake-password')
+	})
+
+	test('ollama: no extra ports, wildcard origins left alone', () => {
+		const {analysis, environment} = analyse('ollama')
+		expect(remoteAccessPorts(analysis)).toEqual([])
+		expect(analysis.env.find((entry) => entry.name === 'OLLAMA_ORIGINS')?.kind).toBe('trusted-origins')
+		expect(environment).toEqual({})
+	})
+
+	test('murmur: wildcard allowed hosts left alone, no extra ports', () => {
+		const {analysis, environment} = analyse('murmur')
+		expect(remoteAccessPorts(analysis)).toEqual([])
+		expect(Object.values(environment).flatMap(Object.keys)).not.toContain('ALLOWED_HOSTS')
+	})
+
+	test('librechat: no extra ports, env_file warning', () => {
+		const {analysis, environment} = analyse('librechat')
+		expect(remoteAccessPorts(analysis)).toEqual([])
+		expect(analysis.warnings.some((warning) => warning.includes('env_file'))).toBe(true)
+		expect(environment).toEqual({})
+	})
+
+	test.each(['stirling-pdf', 'openclaw', 'ekko-studio'])('%s: no extra ports and no rewrites', (appId) => {
+		const {analysis, environment} = analyse(appId)
+		expect(analysis.gateway).not.toBeNull()
+		expect(remoteAccessPorts(analysis)).toEqual([])
+		expect(analysis.env.filter((entry) => entry.kind === 'rewrite')).toEqual([])
+		expect(environment).toEqual({})
+	})
+})
+
+describe('declarations', () => {
+	test('local override wins over manifest and can turn auth off for a port', () => {
+		const {manifest} = fixture('lobe-chat')
+		const {analysis} = analyse('lobe-chat', {
+			manifest: {...manifest, remoteAccess: {ports: [{port: 7459}]}},
+			localOverride: {ports: [{port: 7458, auth: 'app'}, {port: 7459}]},
+		})
