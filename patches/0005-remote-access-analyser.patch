diff --git a/packages/umbreld/source/modules/app-gateway/app-gateway-remote-ports.unit.test.ts b/packages/umbreld/source/modules/app-gateway/app-gateway-remote-ports.unit.test.ts
new file mode 100644
index 0000000..598480c
--- /dev/null
+++ b/packages/umbreld/source/modules/app-gateway/app-gateway-remote-ports.unit.test.ts
@@ -0,0 +1,301 @@
+import http from 'node:http'
+import net from 'node:net'
+
+import {afterEach, describe, expect, test, vi} from 'vitest'
+
+import {resolveRemoteDomain} from '../lan-ingress/remote-domain.js'
+import AppGateway from './app-gateway.js'
+import {
+	applyCorsHeaders,
+	handoffFormPage,
+	preflightHeaders,
+	remoteHostsMarker,
+	rewritePortUrl,
+	type GatewayPortRoute,
+} from './remote-ports.js'
+
+const remote = resolveRemoteDomain({enabled: true, baseDomain: 'example.com'})!
+const MAIN = 'lobe-chat-umbrel.example.com'
+const S3 = 'lobe-chat-7458-umbrel.example.com'
+const GW = 'lobe-chat-7459-umbrel.example.com'
+const SESSION = '__Host-UMBREL_APP_SESSION_HTTPS'
+const MARKER = '__Host-UMBREL_REMOTE_HOSTS'
+
+const route = (host: string, port: number, containerPort: number, auth: 'umbrel' | 'app' = 'umbrel'): GatewayPortRoute => ({
+	host,
+	origin: `https://${host}`,
+	port,
+	auth,
+	targetHost: `lobe-chat_x_1`,
+	targetAddress: '127.0.0.1',
+	containerPort,
+	lanOrigin: `http://umbrel.local:${port}`,
+})
+
+describe('remote port helpers', () => {
+	test('marker depends only on the hosts that need Umbrel login', () => {
+		const a = remoteHostsMarker([route(S3, 7458, 1), route(GW, 7459, 2)])
+		expect(a).toHaveLength(22)
+		expect(remoteHostsMarker([route(GW, 7459, 3), route(S3, 7458, 4)])).toBe(a)
+		expect(remoteHostsMarker([route(S3, 7458, 1, 'app')])).toBe('')
+	})
+
+	test('handoff page escapes fields and pins form-action to the target origin', () => {
+		const page = handoffFormPage(`https://${S3}/umbrel_/api/v1/auth/handoff`, {r: '/"><script>x</script>', handoff: 'h'})
+		expect(page.body).not.toContain('<script>x')
+		expect(page.headers['content-security-policy']).toContain(`form-action https://${S3};`)
+		expect(page.headers['cache-control']).toBe('no-store')
+	})
+
+	test('preflight echoes only well-formed methods and headers', () => {
+		const headers = preflightHeaders(
+			{headers: {'access-control-request-method': 'PUT', 'access-control-request-headers': 'content-type, x-amz-date'}} as never,
+			`https://${MAIN}`,
+		)
+		expect(headers).toMatchObject({'access-control-allow-methods': 'PUT', 'access-control-allow-headers': 'content-type, x-amz-date'})
+		const bad = preflightHeaders({headers: {'access-control-request-method': 'PUT\r\nX: y'}} as never, `https://${MAIN}`)
+		expect(bad['access-control-allow-methods']).toBeUndefined()
+	})
+
+	test('CORS replaces an upstream wildcard with the exact origin and exposes ETag', () => {
+		const headers: http.IncomingHttpHeaders = {'access-control-allow-origin': '*', vary: 'Accept'}
+		applyCorsHeaders(headers, `https://${MAIN}`)
+		expect(headers).toMatchObject({
+			'access-control-allow-origin': `https://${MAIN}`,
+			'access-control-allow-credentials': 'true',
+			vary: 'Accept, Origin',
+			'access-control-expose-headers': 'ETag',
+		})
+	})
+
+	test('LAN port URLs become the port host', () => {
+		expect(rewritePortUrl('http://umbrel.local:7458/lobe/a.png', [route(S3, 7458, 9000)])).toBe(`https://${S3}/lobe/a.png`)
+		expect(rewritePortUrl('https://elsewhere.example/a', [route(S3, 7458, 9000)])).toBe('https://elsewhere.example/a')
+	})
+})
+
+const navigate = {'sec-fetch-mode': 'navigate', accept: 'text/html'}
+
+describe('app gateway extra port hosts', () => {
+	const closers: Array<() => Promise<void>> = []
+	afterEach(async () => {
+		await Promise.all(closers.splice(0).map((close) => close()))
+	})
+	const closeServer = (server: http.Server) => () =>
+		new Promise<void>((resolve) => {
+			server.closeAllConnections?.()
+			server.close(() => resolve())
+		})
+
+	async function upstream(name: string) {
+		const seen: http.IncomingHttpHeaders[] = []
+		const server = http.createServer((request, response) => {
+			seen.push(request.headers)
+			response.setHeader('access-control-allow-origin', '*')
+			response.end(name)
+		})
+		server.on('upgrade', (request, socket) => {
+			seen.push(request.headers)
+			socket.end('HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n\r\n')
+		})
+		await new Promise<void>((resolve) => server.listen(0, '127.0.0.1', resolve))
+		closers.push(closeServer(server))
+		return {port: (server.address() as net.AddressInfo).port, seen}
+	}
+
+	async function start({auth = 'umbrel' as 'umbrel' | 'app', appAuth = true} = {}) {
+		const main = await upstream('main')
+		const s3 = await upstream('s3')
+		const gw = await upstream('gw')
+		const routes = [route(S3, 7458, s3.port, auth), route(GW, 7459, gw.port)]
+		const umbreld = {
+			logger: {error: vi.fn()},
+			dataDirectory: '/does-not-exist',
+			auth: {
+				appAccessRevision: 0,
+				authenticate: vi.fn(async (token: string | undefined) => {
+					if (token !== 'good') throw new Error('unauthenticated')
+					return {userId: 1}
+				}),
+				authorizeApp: vi.fn(),
+				issueAppHandoff: vi.fn(async () => 'next-handoff'),
+				consumeAppHandoff: vi.fn(async (_appId: string, handoff: string) => {
+					if (!handoff.endsWith('handoff')) throw new Error('bad handoff')
+					return {appGatewayToken: 'good'}
+				}),
+				registerAppSocket: vi.fn(() => true),
+			},
+		}
+		const gateway = new AppGateway(
+			umbreld as never,
+			{
+				appId: 'lobe-chat',
+				appName: 'Lobe Hub',
+				appIcon: 'https://example.com/icon.svg',
+				targetProtocol: 'http',
+				targetHost: 'lobe-chat_app_1',
+				targetAddress: '127.0.0.1',
+				targetPort: main.port,
+				auth: appAuth,
+				authWhitelist: [],
+				authBlacklist: [],
+				trustUpstream: false,
+				timeout: 2000,
+			},
+			{getRemoteDomain: () => remote, getRemotePorts: () => routes},
+		)
+		closers.push(closeServer(gateway.server))
+		await new Promise<void>((resolve) => gateway.server.listen(0, '127.0.0.1', resolve))
+		const base = `http://127.0.0.1:${(gateway.server.address() as net.AddressInfo).port}`
+		const request = (host: string, path = '/', init: RequestInit & {headers?: Record<string, string>} = {}) =>
+			fetch(`${base}${path}`, {
+				redirect: 'manual',
+				...init,
+				headers: {'x-forwarded-host': host, 'x-forwarded-proto': 'https', ...(init.headers ?? {})},
+			})
+		// fetch() forces Sec-Fetch-Mode: cors, so navigations use http.request.
+		const navigation = (host: string, path: string, headers: Record<string, string> = {}) =>
+			new Promise<{status: number; location?: string; body: string}>((resolve, reject) => {
+				const outgoing = http.request(`${base}${path}`, {
+					headers: {'x-forwarded-host': host, 'x-forwarded-proto': 'https', ...navigate, ...headers},
+				})
+				outgoing.on('response', async (response) => {
+					let body = ''
+					for await (const chunk of response) body += chunk
+					resolve({status: response.statusCode!, location: response.headers.location, body})
+				})
+				outgoing.on('error', reject)
+				outgoing.end()
+			})
+		return {request, navigation, base, main, s3, gw, umbreld}
+	}
+
+		test('an unauthenticated navigation to a port host goes to the auth host with the port', async () => {
+		const {navigation} = await start()
+		const response = await navigation(S3, '/lobe/file.png')
+		expect(response.status).toBe(302)
+		const location = new URL(response.location!)
+		expect(location.origin).toBe('https://umbrel-auth.example.com')
+		expect(location.searchParams.get('app')).toBe('lobe-chat')
+		expect(location.searchParams.get('port')).toBe('7458')
+		expect(location.searchParams.get('path')).toBe('/lobe/file.png')
+	})
+
+	test('an unauthenticated fetch gets 401, with CORS only for the app own origins', async () => {
+		const {request, s3} = await start()
+		const own = await request(S3, '/x', {headers: {origin: `https://${MAIN}`}})
+		expect(own.status).toBe(401)
+		expect(own.headers.get('access-control-allow-origin')).toBe(`https://${MAIN}`)
+		const foreign = await request(S3, '/x', {headers: {origin: 'https://other-umbrel.example.com'}})
+		expect(foreign.status).toBe(401)
+		expect(foreign.headers.get('access-control-allow-origin')).toBeNull()
+		expect(s3.seen).toHaveLength(0)
+	})
+
+	test('an authenticated request is proxied with the port host and without Umbrel cookies', async () => {
+		const {request, s3} = await start()
+		const response = await request(S3, '/lobe/file.png', {
+			headers: {cookie: `${SESSION}=good; ${MARKER}=m; app=1`, origin: `https://${MAIN}`},
+		})
+		expect(response.status).toBe(200)
+		expect(await response.text()).toBe('s3')
+		expect(response.headers.get('access-control-allow-origin')).toBe(`https://${MAIN}`)
+		expect(response.headers.get('access-control-allow-credentials')).toBe('true')
+		expect(s3.seen[0]).toMatchObject({host: S3, 'x-forwarded-host': S3, 'x-forwarded-proto': 'https', cookie: 'app=1'})
+	})
+
+	test('preflights from the app own origins are answered without credentials', async () => {
+		const {request, s3} = await start()
+		const ok = await request(S3, '/lobe/upload', {
+			method: 'OPTIONS',
+			headers: {origin: `https://${MAIN}`, 'access-control-request-method': 'PUT'},
+		})
+		expect(ok.status).toBe(204)
+		expect(ok.headers.get('access-control-allow-methods')).toBe('PUT')
+		const foreign = await request(S3, '/lobe/upload', {
+			method: 'OPTIONS',
+			headers: {origin: 'https://evil.example', 'access-control-request-method': 'PUT'},
+		})
+		expect(foreign.status).toBe(401)
+		expect(s3.seen).toHaveLength(0)
+	})
+
+	test('auth: app ports are proxied without an Umbrel session', async () => {
+		const {request, s3} = await start({auth: 'app'})
+		const response = await request(S3, '/lobe/upload', {method: 'PUT', body: 'x'})
+		expect(response.status).toBe(200)
+		expect(s3.seen).toHaveLength(1)
+	})
+
+	test('login on the main host hands the session to each port host, then returns', async () => {
+		const {request, umbreld} = await start()
+		const form = (fields: Record<string, string>) => ({
+			method: 'POST',
+			body: new URLSearchParams(fields).toString(),
+			headers: {'content-type': 'application/x-www-form-urlencoded'},
+		})
+		const first = await request(MAIN, '/umbrel_/api/v1/auth/handoff', form({handoff: 'login-handoff', r: '/chat'}))
+		expect(first.status).toBe(200)
+		const cookies = first.headers.getSetCookie().join('\n')
+		expect(cookies).toContain(`${SESSION}=good`)
+		expect(cookies).toContain(`${MARKER}=${remoteHostsMarker([route(S3, 7458, 0), route(GW, 7459, 0)])}`)
+		const page = await first.text()
+		expect(page).toContain(`action="https://${S3}/umbrel_/api/v1/auth/handoff"`)
+		expect(page).toContain('value="next-handoff"')
+		expect(page).not.toContain('login-handoff')
+
