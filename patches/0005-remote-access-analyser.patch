--- /dev/null
+++ b/packages/umbreld/source/modules/lan-ingress/remote-access-files.ts
@@ -0,0 +1,123 @@
+import fse from 'fs-extra'
+import yaml from 'js-yaml'
+
+import type Umbreld from '../../index.js'
+import {getHostname, getIpAddresses} from '../system/system.js'
+import {analyseRemoteAccess, parseStaticExports, type RemoteAccessAnalysis} from './remote-access.js'
+
+// Disk side of the remote access analysis: the owner's local override, the
+// app's static exports, device names, and the saved result.
+//
+//   <umbreld data>/remote-access/<appId>.yml            owner's override (remoteAccess block)
+//   <umbreld data>/remote-access/analysis/<appId>.json  last analysis + applied env names
+
+export function remoteAccessDirectory(umbreld: Pick<Umbreld, 'dataDirectory'>) {
+	return `${umbreld.dataDirectory}/remote-access`
+}
+
+function validAppId(appId: string) {
+	return /^[a-zA-Z0-9-]+$/.test(appId)
+}
+
+export async function readRemoteAccessOverride(umbreld: Pick<Umbreld, 'dataDirectory'>, appId: string) {
+	if (!validAppId(appId)) return {value: undefined, error: undefined}
+	const path = `${remoteAccessDirectory(umbreld)}/${appId}.yml`
+	const contents = await fse.readFile(path, 'utf8').catch(() => undefined)
+	if (contents === undefined) return {value: undefined, error: undefined}
+	try {
+		const parsed = yaml.load(contents) as {remoteAccess?: unknown} | null
+		// Accept the block either at the top level or under `remoteAccess:`.
+		const value = parsed && typeof parsed === 'object' && 'remoteAccess' in parsed ? parsed.remoteAccess : parsed
+		return {value: value ?? undefined, error: undefined}
+	} catch {
+		return {value: undefined, error: `local override ${appId}.yml is not valid YAML`}
+	}
+}
+
+export async function readStaticAppExports(appDataDirectory: string) {
+	const contents = await fse.readFile(`${appDataDirectory}/exports.sh`, 'utf8').catch(() => '')
+	return parseStaticExports(contents)
+}
+
+export async function deviceHosts(lanHostname: string) {
+	const hosts = new Set([lanHostname, lanHostname.replace(/\.local$/, '')])
+	const hostname = await getHostname().catch(() => '')
+	if (hostname) {
+		hosts.add(hostname)
+		hosts.add(`${hostname}.local`)
+	}
+	// getIpAddresses() is async in the Docker build (patch 0003) and sync upstream.
+	const ips = await Promise.resolve()
+		.then(() => getIpAddresses())
+		.catch(() => [] as string[])
+	for (const ip of ips) hosts.add(ip)
+	return [...hosts].filter(Boolean).map((host) => host.toLowerCase())
+}
+
+export async function analyseInstalledApp(
+	umbreld: Pick<Umbreld, 'dataDirectory'>,
+	{
+		appId,
+		appDataDirectory,
+		compose,
+		lanHostname,
+		manifestAppAuthAllowed,
+	}: {
+		appId: string
+		appDataDirectory: string
+		compose: unknown
+		lanHostname: string
+		manifestAppAuthAllowed: boolean
+	},
+) {
+	const [manifestText, exports, override, hosts] = await Promise.all([
+		fse.readFile(`${appDataDirectory}/umbrel-app.yml`, 'utf8').catch(() => ''),
+		readStaticAppExports(appDataDirectory),
+		readRemoteAccessOverride(umbreld, appId),
+		deviceHosts(lanHostname),
+	])
+	let manifest: {port?: unknown; remoteAccess?: unknown} | null = null
+	try {
+		manifest = (yaml.load(manifestText) as typeof manifest) ?? null
+	} catch {}
+	const analysis = analyseRemoteAccess({
+		appId,
+		manifest,
+		compose,
+		exports,
+		deviceHosts: hosts,
+		localOverride: override.value,
+		manifestAppAuthAllowed,
+	})
+	if (override.error) analysis.declarationErrors.unshift(override.error)
+	return {analysis, exports, deviceHosts: hosts}
+}
+
+export type SavedRemoteAccess = {
+	analysedAt: string
+	remoteDomainActive: boolean
+	disabled: boolean
+	// Variable names (never values) written to the user-settings override.
+	appliedEnvironment: Array<{service: string; name: string}>
+	analysis: RemoteAccessAnalysis
+}
+
+export async function saveRemoteAccessAnalysis(
+	umbreld: Pick<Umbreld, 'dataDirectory'>,
+	appId: string,
+	saved: SavedRemoteAccess,
+) {
+	if (!validAppId(appId)) return
+	const directory = `${remoteAccessDirectory(umbreld)}/analysis`
+	await fse.ensureDir(directory)
+	const path = `${directory}/${appId}.json`
+	await fse.writeFile(`${path}.tmp`, `${JSON.stringify(saved, null, '\t')}\n`)
+	await fse.rename(`${path}.tmp`, path)
+}
+
+export async function readSavedRemoteAccessAnalysis(umbreld: Pick<Umbreld, 'dataDirectory'>, appId: string) {
+	if (!validAppId(appId)) return null
+	return (await fse
+		.readJson(`${remoteAccessDirectory(umbreld)}/analysis/${appId}.json`)
+		.catch(() => null)) as SavedRemoteAccess | null
+}
